# GitHub write access for the admin API. Keep the real value only in .env
# locally and in your hosting provider's environment variables.
GITHUB_PAT="your_github_personal_access_token"

# Admin API credentials. These are checked server-side by functions/api/github.js.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change_me"

# Repository target for GitHub content edits.
GITHUB_OWNER="ErenAri"
GITHUB_REPO="kernel-guard-frontend"

# Contact form access key for the Vite client.
VITE_WEB3FORMS_ACCESS_KEY="your_access_key_here"

# Optional Gemini API key exposed by vite.config.ts for legacy AI features.
GEMINI_API_KEY="your_gemini_api_key"

# Optional site URL used by sitemap/prerender scripts.
SITE_URL="https://www.kernelguard.net"
